<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.yuuu.mapper.ArticleMapper">
    <insert id="insertArticleTag">
        insert into yuuu_article_tag
        values
        <foreach collection="tags" item="tagId" separator=",">
            (#{articleId}, #{tagId})
        </foreach>
    </insert>
    <delete id="deleteArticleTagById">
        delete from yuuu_article_tag where article_id = #{articleId}
    </delete>
    <select id="getArticleByInput" resultType="com.yuuu.domain.vo.ArticleInputVo">
        SELECT id,title FROM yuuu_article
        WHERE title LIKE CONCAT('%', #{inputValue}, '%') and `status` = '0' and del_flag = 0
    </select>


</mapper>